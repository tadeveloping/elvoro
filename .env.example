# Skopíruj do .env.local (lokálne) alebo nastav vo Verceli. Hodnoty nikdy nedávaj do chatu ani do gitu.

# Neon: pripojovací reťazec databázy (Vercel ho doplní sám pri pripojení Neon cez Marketplace).
DATABASE_URL=

# Resend: API kľúč, odosielateľ z overenej domény a adresa, kam chodia nové prihlášky.
RESEND_API_KEY=
PRIHLASKY_FROM="Elvoro web <web@elvoro.sk>"
PRIHLASKY_TO=
